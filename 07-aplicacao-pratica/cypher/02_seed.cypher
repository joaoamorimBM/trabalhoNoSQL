  ['beatriz.lins',    ['Inteligência Artificial', 'Ciência de Dados', 'Livros']],
  ['mateus.sampaio',  ['Tecnologia', 'Corrida', 'Cinema']],
  ['camila.prado',    ['Fotografia', 'Design', 'Viagem']],
  ['renan.oliveira',  ['Kitesurf', 'Viagem', 'Fotografia']],
  ['vitor.hugo',      ['Corrida', 'Futebol', 'Culinária']],
  ['amanda.queiroz',  ['Games', 'Cinema', 'Tecnologia']],
  ['joao.victor',     ['Games', 'Tecnologia', 'Forró']],
  ['patricia.gomes',  ['Culinária', 'Café', 'Viagem', 'Fotografia', 'Empreendedorismo']],
  ['daniel.moura',    ['Forró', 'Música', 'Culinária']],
  ['leticia.araujo',  ['Culinária', 'Corrida', 'Livros']],
  ['sofia.martins',   ['Cinema', 'Livros', 'Música', 'Viagem']],
  ['gustavo.ramos',   ['Empreendedorismo', 'Tecnologia', 'Inteligência Artificial']],
  ['fernanda.lopes',  ['Educação', 'Livros', 'Cinema']],
  ['rita.cavalcante', ['Culinária', 'Livros', 'Música']]
] AS par
MATCH (u:Usuario {username: par[0]})
UNWIND par[1] AS nomeInteresse
MERGE (i:Interesse {nome: nomeInteresse})
MERGE (u)-[:INTERESSADO_EM]->(i);

