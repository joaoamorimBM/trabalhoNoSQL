// Dados de exemplo da rede social.
// Responsável pelo dataset: Vinícius (ver 00-divisao e 06-rede-social).
// Perfis fictícios, mas com cidades, profissões, interesses e posts plausíveis para o Nordeste.
// Grupos de propósito: tecnologia em Fortaleza, dados em Recife e Teresina, foto e viagem,
// esporte e games, música e culinária. Há perfis populares (patricia.gomes, marina.castro)
// e perfis mais isolados (fernanda.lopes, rita.cavalcante) para os graus de separação.
// Datas são relativas ao momento do seed (datetime() - duração), então o feed sempre parece recente.
// Usa MERGE: rodar de novo não duplica nada.
// Atenção: o script scripts/seed.py separa as instruções por ponto e vírgula,
// então não use esse caractere dentro dos textos.

// ---------- Usuários (30)
UNWIND [
  {username: 'ana.souza', nome: 'Ana Souza', cidade: 'Fortaleza', bio: 'Dev backend em Python e fã de café coado', diasConta: 820},
  {username: 'bruno.lima', nome: 'Bruno Lima', cidade: 'Fortaleza', bio: 'Analista de sistemas e fotógrafo nas horas vagas', diasConta: 760},
  {username: 'carla.mendes', nome: 'Carla Mendes', cidade: 'Recife', bio: 'Cientista de dados, trabalha com detecção de fraude', diasConta: 690},
  {username: 'diego.alves', nome: 'Diego Alves', cidade: 'Natal', bio: 'Corredor de rua e gamer de fim de semana', diasConta: 540},
  {username: 'elisa.rocha', nome: 'Elisa Rocha', cidade: 'Fortaleza', bio: 'Designer de produto, UX e ilustração', diasConta: 610},
  {username: 'felipe.costa', nome: 'Felipe Costa', cidade: 'São Paulo', bio: 'Músico e professor de violão', diasConta: 900},
  {username: 'gabi.nunes', nome: 'Gabriela Nunes', cidade: 'Recife', bio: 'Viajante e escritora de guias de viagem', diasConta: 480},
  {username: 'heitor.reis', nome: 'Heitor Reis', cidade: 'Teresina', bio: 'Engenheiro de dados, pipelines e nuvem', diasConta: 450},
  {username: 'iris.melo', nome: 'Íris Melo', cidade: 'Fortaleza', bio: 'Estudante de Ciência da Computação', diasConta: 120},
  {username: 'jonas.pinto', nome: 'Jonas Pinto', cidade: 'Natal', bio: 'Chef de cozinha regional', diasConta: 830},
  {username: 'marina.castro', nome: 'Marina Castro', cidade: 'Fortaleza', bio: 'Professora de banco de dados e orientadora de TCC', diasConta: 870},
  {username: 'rafael.teixeira', nome: 'Rafael Teixeira', cidade: 'Fortaleza', bio: 'Dev mobile e pai de dois', diasConta: 640},
  {username: 'larissa.freitas', nome: 'Larissa Freitas', cidade: 'Maracanaú', bio: 'Analista de testes e voluntária em comunidade de mulheres na TI', diasConta: 380},
  {username: 'thiago.barros', nome: 'Thiago Barros', cidade: 'Fortaleza', bio: 'DevOps de dia, kitesurf no fim de semana', diasConta: 590},
  {username: 'pedro.henrique', nome: 'Pedro Henrique', cidade: 'Sobral', bio: 'Estagiário de suporte e estudante de ADS', diasConta: 90},
  {username: 'lucas.farias', nome: 'Lucas Farias', cidade: 'Recife', bio: 'Analista de BI, SQL e painéis', diasConta: 520},
  {username: 'beatriz.lins', nome: 'Beatriz Lins', cidade: 'Recife', bio: 'Pesquisadora em aprendizado de máquina', diasConta: 300},
  {username: 'mateus.sampaio', nome: 'Mateus Sampaio', cidade: 'Teresina', bio: 'Engenheiro de software e corredor amador', diasConta: 410},
  {username: 'camila.prado', nome: 'Camila Prado', cidade: 'Juazeiro do Norte', bio: 'Fotógrafa de casamentos no Cariri', diasConta: 700},
  {username: 'renan.oliveira', nome: 'Renan Oliveira', cidade: 'Jijoca de Jericoacoara', bio: 'Guia de turismo e instrutor de kitesurf', diasConta: 650},
  {username: 'vitor.hugo', nome: 'Vitor Hugo', cidade: 'Natal', bio: 'Personal trainer e maratonista', diasConta: 560},
  {username: 'amanda.queiroz', nome: 'Amanda Queiroz', cidade: 'Mossoró', bio: 'Streamer de jogos independentes', diasConta: 330},
  {username: 'joao.victor', nome: 'João Victor', cidade: 'Campina Grande', bio: 'Estudante de Engenharia Elétrica', diasConta: 150},
  {username: 'patricia.gomes', nome: 'Patrícia Gomes', cidade: 'Fortaleza', bio: 'Blog de comida cearense, receita nova toda semana', diasConta: 880},
  {username: 'daniel.moura', nome: 'Daniel Moura', cidade: 'Caruaru', bio: 'Sanfoneiro de forró pé de serra', diasConta: 720},
  {username: 'leticia.araujo', nome: 'Letícia Araújo', cidade: 'João Pessoa', bio: 'Nutricionista esportiva', diasConta: 430},
  {username: 'sofia.martins', nome: 'Sofia Martins', cidade: 'Salvador', bio: 'Jornalista de cultura', diasConta: 610},
  {username: 'gustavo.ramos', nome: 'Gustavo Ramos', cidade: 'São Paulo', bio: 'Fundador de startup de logística', diasConta: 500},
  {username: 'fernanda.lopes', nome: 'Fernanda Lopes', cidade: 'São Luís', bio: 'Professora de inglês e leitora compulsiva', diasConta: 260},
  {username: 'rita.cavalcante', nome: 'Rita Cavalcante', cidade: 'Sobral', bio: 'Professora aposentada, cozinha e crochê', diasConta: 200}
] AS dado
MERGE (u:Usuario {username: dado.username})
ON CREATE SET u.nome = dado.nome, u.cidade = dado.cidade, u.bio = dado.bio,
              u.criadoEm = datetime() - duration({days: dado.diasConta});

