  {id: 'seed-53', autor: 'carla.mendes', dias: 9, horas: 2,
   texto: 'Palestra sobre detecção de fraude com grafos no Porto Digital quinta'},
  {id: 'seed-54', autor: 'elisa.rocha', dias: 8, horas: 5,
   texto: 'Teste de usabilidade hoje com 5 usuários, muitas descobertas'},
  {id: 'seed-55', autor: 'heitor.reis', dias: 11, horas: 3,
   texto: 'Alguém em Teresina topa um grupo de corrida às terças?'},
  {id: 'seed-56', autor: 'felipe.costa', dias: 7, horas: 4,
   texto: 'Aula de violão online aberta, o tema é baião'},
  {id: 'seed-57', autor: 'gabi.nunes', dias: 13, horas: 6,
   texto: 'Próximo destino: Lençóis Maranhenses'},
  {id: 'seed-58', autor: 'jonas.pinto', dias: 6, horas: 3,
   texto: 'Cardápio novo do restaurante com peixe ao molho de coco'},
  {id: 'seed-59', autor: 'bruno.lima', dias: 10, horas: 1,
   texto: 'Ensaio fotográfico no Dragão do Mar sábado à tarde'},
  {id: 'seed-60', autor: 'diego.alves', dias: 16, horas: 6,
   texto: 'Fechei os 10 km abaixo de 50 minutos!'}
] AS dado
MATCH (u:Usuario {username: dado.autor})
MERGE (p:Post {id: dado.id})
ON CREATE SET p.conteudo = dado.texto,
              p.criadoEm = datetime() - duration({days: dado.dias, hours: dado.horas})
MERGE (u)-[:PUBLICOU]->(p);

