# Copie este arquivo para .env e preencha.
#
# Opção A — Neo4j local (zip, Docker ou Neo4j Desktop) — usado na apresentação:
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha
NEO4J_DATABASE=neo4j
#
# Opção B — Neo4j AuraDB Free (nuvem, plano de contingência): use a URI do arquivo de credenciais baixado no console da Aura
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=senha-gerada-pela-aura
# NEO4J_DATABASE=neo4j

FLASK_PORT=5000
